# Copy this file to .env.local in this same folder (Spike/gemini/) and fill
# in your own key. .env.local is gitignored — it never gets committed, and
# nobody but you ever sees the value in it.
#
# Get a free key at https://aistudio.google.com (Google account, no card).

GEMINI_API_KEY=your-key-here

# Optional — override the default model. Check the exact model name shown
# for your key at aistudio.google.com if the default below stops working.
# GEMINI_MODEL=gemini-2.5-flash-lite
