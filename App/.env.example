# Copy this file to .env.local (already gitignored via the *.local rule) and
# fill in your Supabase project's values: Dashboard -> Project Settings -> API.
#
# VITE_SUPABASE_ANON_KEY is the publishable/anon key (starts with sb_publishable_
# on new projects, or is a JWT on older ones) — safe to expose in client code.
# NEVER put the secret service_role key in this app; it must never reach the client.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
